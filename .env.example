# Google Gemini API Keys (comma-separated for automatic round-robin rotation)
GOOGLE_API_KEYS=AIzaSyYourFirstKeyHere,AIzaSyYourSecondKeyHere
# Primary Google Gemini API Key (fallback if GOOGLE_API_KEYS is not set)
GOOGLE_API_KEY=AIzaSyYourFirstKeyHere

# Groq Cloud API Key (for high-throughput RAG failure post-mortem synthesis & secondary fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Server Port (Default: 8000 for local dev, 7860 for Hugging Face Spaces)
PORT=8000
